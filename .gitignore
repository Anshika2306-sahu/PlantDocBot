# 🧠 Ignore model and large data files
*.pth
*.pt
*.bin
*.h5
*.ckpt
*.zip
*.tar
*.tar.gz
*.npy
*.npz

# 🚫 Ignore Python cache and virtual environments
__pycache__/
*.pyc
*.pyo
*.pyd
venv/
.venv/
env/
.env/

# 🧰 Ignore build and node modules
node_modules/
dist/
build/

# 🌿 Ignore IDE and system files
.DS_Store
Thumbs.db
.vscode/
.idea/

# 📦 Ignore log and temporary files
*.log
*.tmp
*.bak

# 🧩 Ignore datasets
dataset/
data/
